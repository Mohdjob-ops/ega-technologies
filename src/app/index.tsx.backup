          <Text style={styles.founderName}>
            Mohammed Elmi Issak
          </Text>

          <Text style={styles.founderRole}>
            Founder, Elmi Guray Foundation
          </Text>

          <Text style={styles.founderRole}>
            Founder & President, Elmi Guray Academy
          </Text>
        </View>
