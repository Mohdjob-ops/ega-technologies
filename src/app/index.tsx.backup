            </Pressable>

            <Pressable
              accessibilityRole="button"
              accessibilityLabel="Open learner portal"
              style={({ pressed }) => [
                styles.navigationCard,
                { width: twoColumnCardWidth },
                pressed && styles.cardPressed,
              ]}
              onPress={() => router.push("/learner-portal")}
            >
