                pressed && styles.cardPressed,
              ]}
              onPress={() => router.push("/leaderboard")}
            >
              <Text style={styles.navigationTitle}>
                🏆 Student Leaderboard
              </Text>

              <Text style={styles.navigationText}>
                Celebrate student achievement and view top
